# Database
MONGODB_URI=mongodb://localhost:27017/projexify_db

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRY=7d

# Bootstrap admin (first startup only; never commit real values)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# Gemini AI (optional)
GEMINI_API_KEY=

# Server
PORT=3005
NODE_ENV=development
CORS_ORIGIN=http://localhost:3005
FRONTEND_URL=http://localhost:3005

# Upload storage
# In production point this at a persistent mounted disk.
MAX_FILE_SIZE=104857600
UPLOAD_DIR=./backend/uploads

# Demo paid enrollment is disabled by default.
# Enable only for portfolio/demo environments; this is NOT a real payment capture.
ENABLE_DEMO_PAYMENTS=false

# SMTP (optional but required for password reset email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Content Shield
ENABLE_CONTENT_SHIELD=true
WATERMARK_TEXT=Projexify™

# Application URLs
REGISTER_URL=/login.html
LOGIN_URL=/login.html
RESET_PASSWORD_URL=/reset-password.html
